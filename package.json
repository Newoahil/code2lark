{
  "name": "lark-deployer",
  "version": "0.1.0",
  "private": true,
  "description": "Build-time generator for connecting existing services to Lark/Feishu bots.",
  "type": "module",
  "bin": {
    "lark-deployer": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "check": "npm run build",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.10",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
